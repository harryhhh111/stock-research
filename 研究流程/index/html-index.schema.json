{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research HTML index v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reports",
    "redirects"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "reports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/report"
      }
    },
    "redirects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "report_id"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "report_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    }
  },
  "$defs": {
    "report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "report_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "entity_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(company|topic|protocol|token|other):[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "project_dir": {
          "type": "string",
          "minLength": 1
        },
        "entry_path": {
          "type": "string",
          "minLength": 1
        },
        "report_type": {
          "enum": [
            "company_research",
            "topic",
            "update",
            "demo"
          ]
        },
        "status": {
          "enum": [
            "draft",
            "ready",
            "archived"
          ],
          "description": "交付维护状态：draft仍在编写；ready已交付可阅读；archived退出当前维护。不是内容核验结论或访问权限。"
        },
        "content_status": {
          "enum": [
            "unreviewed",
            "partial",
            "verified",
            "synthetic"
          ],
          "description": "独立记录内容验收结果；不因ready、正文哈希或结构检查自动提升。"
        },
        "document_updated_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "financial_as_of": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "market_as_of": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "layout": {
          "enum": [
            "standard",
            "legacy"
          ]
        },
        "assets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unpublished_links": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "description": "本地来源超链接到不可访问原因的映射；不阻止正文ready，不豁免必需展示资源。"
        },
        "content_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "绑定登记正文版本；不证明事实核验通过。ready必须提供。"
        }
      },
      "required": [
        "report_id",
        "title",
        "entity_id",
        "project_dir",
        "entry_path",
        "report_type",
        "status",
        "content_status",
        "document_updated_at",
        "financial_as_of",
        "market_as_of",
        "layout",
        "assets",
        "unpublished_links",
        "content_sha256"
      ]
    }
  }
}
